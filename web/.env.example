# Where the waitlist forms POST.
#
# Decided 2026-09-11: Formspree, so the site can stay on GitHub Pages (web/TASKS.md).
# The form exists: https://formspree.io/f/meaqdnjv
#
# A form id is not a secret -- Astro inlines every PUBLIC_ variable into the browser
# bundle, so it ships to every visitor either way. In production this is the
# PUBLIC_WAITLIST_URL *repo variable* (Settings -> Secrets and variables -> Actions ->
# Variables), read by .github/workflows/deploy-pages.yml. Copying this file to .env
# only configures local `npm run dev` and local builds; it does NOT set the repo
# variable, and both are needed.
#
# Leave it unset and the forms tell visitors signups are not open. They do NOT
# silently accept and drop submissions -- that bug is why this variable exists.
PUBLIC_WAITLIST_URL=https://formspree.io/f/meaqdnjv

# functions/api/waitlist.ts is a Cloudflare Pages Function and does not run on
# GitHub Pages. If the site ever moves to Cloudflare: PUBLIC_WAITLIST_URL=/api/waitlist
