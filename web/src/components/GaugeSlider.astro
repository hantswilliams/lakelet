---
// The hero terminal: one question, a slider for the size of `events`, and the
// gauge changing its verdict as the table grows.
import Terminal from './Terminal.astro';
---
<Terminal title="zsh · ~/acme-analytics · MacBook Pro 16 GB · 190 Mbps" class="gauge-slider" label="Interactive terminal: drag the slider to change the size of the events table and watch the verdict change">
<pre><span class="p">$</span> lakelet init
  catalog   ./.lakelet/catalog.db   <span class="d">(Iceberg REST, SQLite)</span>
  warehouse ./warehouse             <span class="d">(Parquet + Iceberg)</span>

<span class="p">$</span> lakelet ask "daily active users by country, last 90 days"
  <span class="b">select</span> event_date, country, <span class="b">count</span>(<span class="b">distinct</span> user_id) <span class="b">as</span> dau
  <span class="b">from</span> events <span class="b">where</span> event_date &gt;= current_date - <span class="b">interval</span> 90 day
  <span class="b">group by</span> 1, 2 <span class="b">order by</span> 1, 3 <span class="b">desc</span>

  <span id="tDot" class="g">●</span> <span id="tVerdict" class="w">Runs here</span> <span id="tDetail" class="d">· scans 0.4 GB · fits in memory · ~2 s</span>
<span id="tBurst" style="display:none">  <span class="o">&gt;(°)&lt;</span> <span class="d">~~~~~~&gt;</span> burst? 16 vCPU / 64 GB · us-east-1 · cap <span class="w" id="tCap">$0.41</span>   <span class="d">[y/N]</span></span></pre>
  <div class="ctlrow"><span>size of <code>events</code></span><output id="sizeOut">40 GB</output></div>
  <input type="range" id="size" min="1" max="400" value="40" step="1" aria-label="Size of events table">
</Terminal>

<style>
  .ctlrow{display:flex;justify-content:space-between;align-items:center;padding:6px 16px 4px;font-size:12px;color:#9AA8B6}
  :global(.gauge-slider) input[type=range]{width:calc(100% - 32px);margin:0 16px 14px;accent-color:#F5A623}
</style>

<script>
  const RAM = 16;
  const s = document.getElementById('size') as HTMLInputElement, out = document.getElementById('sizeOut')!;
  const dot = document.getElementById('tDot')!, ver = document.getElementById('tVerdict')!, det = document.getElementById('tDetail')!, bl = document.getElementById('tBurst')!, cap = document.getElementById('tCap')!;
  const fmt = (sec: number) => sec < 60 ? Math.round(sec) + ' s' : sec < 3600 ? Math.round(sec / 60) + ' min' : (sec / 3600).toFixed(1) + ' h';
  function update() {
    const gb = +s.value; out.textContent = gb + ' GB';
    const need = gb * 0.15 + 0.1, spill = need > RAM * 0.8, sec = spill ? gb * 6 : gb * 0.22;
    const state = need > RAM * 1.6 ? 'r' : spill ? 'y' : 'g';
    dot.className = state; bl.style.display = state === 'r' ? 'block' : 'none';
    if (state === 'g') { ver.textContent = 'Runs here'; det.textContent = '· scans ' + (gb * 0.01).toFixed(1) + ' GB · fits in memory · ~' + fmt(sec); }
    else if (state === 'y') { ver.textContent = 'Runs here, slowly'; det.textContent = '· spills to disk · ~' + fmt(sec) + ' · ' + need.toFixed(1) + ' / ' + RAM + ' GB'; }
    else { ver.textContent = 'Needs more machine'; det.textContent = '· ' + gb + ' GB from s3://acme-data · ~' + fmt(gb * 0.85) + ' at 190 Mbps · burst ~' + fmt(gb * 0.12); cap.textContent = '$' + (0.4 + gb * 0.006).toFixed(2); }
  }
  s.addEventListener('input', update); update();
</script>
