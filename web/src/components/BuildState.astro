---
// The built-vs-planned strip. Every page that describes something unbuilt carries one.
// It reads src/data/status.ts and nothing else, so a shipped session is a one-file edit.
// See web/TASKS.md, item 2.
import { url } from '../lib/url';
import { pageState, pick, asOf } from '../data/status';

interface Props { page: keyof typeof pageState }
const { page } = Astro.props;
const state = pageState[page];
if (!state) throw new Error(`<BuildState page="${page}"/>: no entry in src/data/status.ts`);

const built = pick(state.built);
const planned = pick(state.planned);
const when = new Date(asOf + 'T00:00:00Z').toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---
<aside class="buildstate" aria-label="What is built and what is planned">
  <p class="lede">{state.note}</p>
  <div class="cols">
    <div class="col is-built">
      <h3><span class="dot" aria-hidden="true"></span>Built and running, {when}</h3>
      <ul>
        {built.map(s => (
          <li>
            {s.href ? <a href={url(s.href)}><b>{s.label}</b></a> : <b>{s.label}</b>}
            <span>{s.detail}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="col is-planned">
      <h3><span class="dot" aria-hidden="true"></span>Designed, not built</h3>
      <ul>
        {planned.map(s => (
          <li>
            <b>{s.label}</b>
            {s.session && <em>{s.session}</em>}
            <span>{s.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="fine">
    The developer docs are the authority: <a href={url('/docs')}>what is built and what is not</a>,
    kept next to the code. Where this site and those pages disagree, those pages are right.
  </p>
</aside>

<style>
  .buildstate{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:22px 24px;margin:0 0 34px}
  .buildstate .lede{font-size:15px;max-width:78ch;margin:0 0 18px;color:var(--ink)}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .cols>*{min-width:0}
  .col h3{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
  .dot{width:9px;height:9px;border-radius:50%;flex:none}
  .is-built .dot{background:var(--local,#1F8A5B)}
  .is-planned .dot{background:var(--shallow,#7FB3D5)}
  .col ul{list-style:none;margin:0;padding:0;display:grid;gap:9px}
  .col li{font-size:13.5px;line-height:1.45;padding-left:15px;position:relative;color:var(--muted)}
  .col li::before{content:'';position:absolute;left:0;top:.55em;width:6px;height:1.5px;background:var(--line)}
  .is-built li::before{background:var(--local,#1F8A5B)}
  .col li b{color:var(--ink);font-weight:700}
  .col li a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--shallow)}
  .col li em{font-style:normal;font:500 11.5px var(--mono);color:var(--muted);background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:1px 5px;margin-left:6px;white-space:nowrap}
  .col li span{display:block}
  .buildstate .fine{margin:18px 0 0;padding-top:14px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted)}
  .buildstate .fine a{color:var(--ink)}
  @media (max-width:820px){ .cols{grid-template-columns:1fr;gap:18px} }
</style>
