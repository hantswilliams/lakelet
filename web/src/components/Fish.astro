---
// Small inline fish glyph, used in the footer and anywhere a marker is wanted.
interface Props { size?: number; class?: string }
const { size = 22, class: cls = '' } = Astro.props;
---
<svg class={cls} width={size} height={Math.round(size * 16 / 22)} viewBox="-24 -12 48 24" aria-hidden="true"><path d="M-12 0 L-22 -8 C-19 -3, -19 3, -22 8 Z" fill="#E8731A"/><ellipse rx="14" ry="9" fill="#F5A623"/><path d="M-3 -8 C0 -14, 6 -13, 7 -7 Z" fill="#E8731A"/><circle cx="7" cy="-2" r="3" fill="#fff"/><circle cx="8" cy="-2" r="1.5" fill="#172029"/></svg>
