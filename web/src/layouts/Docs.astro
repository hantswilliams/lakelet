---
// The developer docs: a sidebar of every page grouped by section, the article, a
// developer-preview banner with the core's version, and prev/next at the bottom.
// Markdown pages render into the default slot; the styles below are global to the
// article because the markdown's HTML is not scoped.
import Base from './Base.astro';
import { url, isCurrent } from '../lib/url';
import { SECTIONS, coreVersion, docLinks, EDIT_BASE, type DocLink } from '../data/docs';

interface Props { title: string; description: string; id: string }
const { title, description, id } = Astro.props;

const links = await docLinks();
const version = coreVersion();
const index = links.findIndex(l => l.id === id);
const prev: DocLink | undefined = links[index - 1];
const next: DocLink | undefined = links[index + 1];
const pathname = Astro.url.pathname;
const editHref = `${EDIT_BASE}/${id}.md`;
---
<Base title={title} description={description}>
  <p class="preview"><b>Developer preview.</b> These pages describe <code>lakelet {version}</code> as it is in the repo today: install from source, CLI first, no installers yet. Anything the site promises that is not on these pages is not built.</p>
  <div class="docs">
    <aside>
      <nav aria-label="Documentation">
        {SECTIONS.map(section => (
          <div class="group">
            <h4>{section}</h4>
            {links.filter(l => l.section === section).map(l => (
              <a href={url(l.href)} aria-current={isCurrent(l.href, pathname) ? 'page' : undefined}>{l.title}</a>
            ))}
          </div>
        ))}
      </nav>
    </aside>
    <article>
      <p class="eyebrow">{links[index]?.section}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="body"><slot /></div>
      <footer class="pager">
        <span>{prev && <a href={url(prev.href)}>← {prev.title}</a>}</span>
        <a class="edit" href={editHref} rel="noopener">Edit this page</a>
        <span>{next && <a href={url(next.href)}>{next.title} →</a>}</span>
      </footer>
    </article>
  </div>
</Base>

<style>
  .preview{margin:4px 0 22px;padding:12px 16px;border-left:4px solid var(--slow);background:var(--panel);border-radius:0 12px 12px 0;color:var(--muted);font-size:14px}
  .preview code{font-size:13px;background:var(--bg);border-radius:4px;padding:1px 5px;color:var(--ink)}
  .docs{display:grid;grid-template-columns:220px minmax(0,1fr);gap:40px;align-items:start;padding-bottom:40px}
  aside{position:sticky;top:20px}
  article{min-width:0}
  .group{margin-bottom:18px}
  .group h4{font:500 11px var(--mono);color:var(--lake);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
  .group a{display:block;padding:5px 10px;margin-left:-10px;border-radius:6px;text-decoration:none;font-size:14px;color:var(--muted)}
  .group a:hover{color:var(--ink);background:var(--panel)}
  .group a[aria-current]{color:var(--lake);font-weight:600;background:var(--cloud)}
  article h1{font-size:clamp(30px,4vw,42px);line-height:1.08;letter-spacing:-.03em;font-weight:800;max-width:24ch}
  article .lede{margin-top:12px}
  .pager{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;margin-top:48px;padding-top:18px;border-top:1px solid var(--line);font-size:14px;font-weight:600}
  .pager span:last-child{text-align:right}
  .pager .edit{font-weight:500;color:var(--muted)}
  @media (max-width:820px){
    .docs{grid-template-columns:minmax(0,1fr);gap:20px}
    aside{position:static}
    nav{display:flex;flex-wrap:wrap;gap:0 18px}
    .group a{display:inline-block;margin-left:0}
  }
</style>

<style is:global>
  /* The markdown body. Kept close to the marketing pages' type: same tokens, same widths. */
  .body{margin-top:28px;max-width:72ch;font-size:16px}
  .body>*+*{margin-top:14px}
  .body h2{font-size:24px;letter-spacing:-.02em;font-weight:800;margin-top:40px;padding-top:18px;border-top:1px solid var(--line)}
  .body h3{font-size:18px;font-weight:700;margin-top:28px}
  .body h4{font-size:15px;font-weight:700;margin-top:22px}
  .body p,.body li{color:var(--ink)}
  .body ul,.body ol{padding-left:22px}
  .body li+li{margin-top:6px}
  .body code{font:500 13.5px var(--mono);background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:1px 5px}
  .body pre{background:var(--term);border:1px solid var(--termline);border-radius:12px;padding:14px 16px;font:12.5px/1.65 var(--mono);overflow:auto}
  .body pre code{background:transparent;border:0;padding:0;font-size:inherit;color:inherit}
  .body h2 code,.body h3 code,.body h4 code{font-size:inherit;font-weight:inherit;background:transparent;border:0;padding:0}
  .body table{width:100%;border-collapse:collapse;font-size:14px;background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:block;overflow-x:auto}
  .body th,.body td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  .body th{font-size:12px;color:var(--muted);font-weight:600;background:#F6F8FA;white-space:nowrap}
  .body tr:last-child td{border-bottom:0}
  .body td code{white-space:nowrap}
  .body blockquote{border-left:4px solid var(--slow);padding:10px 16px;background:var(--panel);border-radius:0 12px 12px 0;color:var(--muted);font-size:15px}
  .body blockquote p{color:var(--muted)}
  .body a{color:var(--lake)}
  .body hr{border:0;border-top:1px solid var(--line);margin:32px 0}
  .body .g{color:var(--local)} .body .y{color:var(--slow)} .body .r{color:var(--burst)}
</style>
