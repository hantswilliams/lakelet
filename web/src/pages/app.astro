<script>
  function fit(){document.querySelectorAll<HTMLElement>('.frame-wrap').forEach(w=>{const f=w.querySelector<HTMLElement>('.frame')!;const s=Math.min(1,w.clientWidth/1180);f.style.transform='scale('+s+')';w.style.height=(1180*10/16*s)+'px';});}
  addEventListener('resize',fit);fit();
</script>
