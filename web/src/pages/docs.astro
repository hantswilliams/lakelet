---
// /docs: the landing page of the developer documentation, rendered from index.md.
import { getEntry, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
const entry = await getEntry('docs', 'index');
if (!entry) throw new Error('src/content/docs/index.md is missing');
const { Content } = await render(entry);
---
<Docs title={entry.data.title} description={entry.data.description} id="index">
  <Content />
</Docs>
